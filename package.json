{
  "name": "paint-electron",
  "version": "1.0.0",
  "description": "Fast, essential image editor built for Ubuntu 26.04 and cross-platform desktop",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron . --no-sandbox --disable-logging --log-level=3",
    "test": "node test/test-algorithms.js",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.paint.electron",
    "productName": "Paint",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/gifenc/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "keywords": [
    "image-editor",
    "paint",
    "electron",
    "ubuntu",
    "linux",
    "photo-editor"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  }
}
