{
  "name": "paint-electron",
  "version": "1.0.0",
  "description": "Fast, essential image editor built for Ubuntu 26.04 and cross-platform desktop",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron . --no-sandbox --disable-logging --log-level=3",
    "install-desktop": "node scripts/install-desktop.js",
    "generate-icon": "node scripts/generate-png-icon.js",
    "test": "node test/test-algorithms.js",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.paint.electron",
    "productName": "Paint",
    "directories": {
      "output": "release"
    },
    "icon": "assets/icon.png",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/gifenc/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "syncDesktopName": true,
      "maintainer": "Norman Tang <norman@normstorm.com>"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "keywords": [
    "image-editor",
    "paint",
    "electron",
    "ubuntu",
    "linux",
    "photo-editor"
  ],
  "author": {
    "name": "Norman Tang",
    "email": "norman@normstorm.com"
  },
  "desktopName": "Paint",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/longhorn09/paint-electron.git"
  },
  "bugs": {
    "url": "https://github.com/longhorn09/paint-electron/issues"
  },
  "homepage": "https://github.com/longhorn09/paint-electron#readme",
  "dependencies": {
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  }
}
